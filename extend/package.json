{
  "name": "acuminata-extends",
  "displayName": "Acuminata Extends",
  "version": "1.0.0",
  "description": "记录你设置的特定网站的浏览历史",
  "author": "RoyHe <roooyhe@163.com>",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "permissions": [
      "tabs",
      "storage",
      "history",
      "scripting"
    ],
    "host_permissions": [
      "<all_urls>"
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self'; connect-src ws://127.0.0.1:8766 ws://localhost:8766 http://127.0.0.1:* http://localhost:*"
    }
  }
}
