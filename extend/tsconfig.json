{
  "extends": "plasmo/templates/tsconfig.base",
  "exclude": [
    "node_modules"
  ],
  "include": [
    ".plasmo/index.d.ts",
    "./**/*.ts",
    "./**/*.tsx",
    "../shared/**/*.ts",
    "../shared/**/*.js"
  ],
  "compilerOptions": {
    "allowJs": true,
    "paths": {
      "~*": [
        "./*"
      ]
    },
    "baseUrl": "."
  }
}
