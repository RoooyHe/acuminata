{
  "_note": "按 https://www.mgtvtv.com/show/2/ 与 /tv/94425/ 的真实 DOM 写成。平台级适配器，只依赖主题无关的东西。",

  "name": "MacCMS",
  "detect": { "pageGlobal": "maccms" },
  "domains": ["www.mgtvtv.com"],

  "collect": [
    { "field": "keywords", "selector": "meta[name='keywords']", "attr": "content" },
    { "field": "desc", "selector": "meta[name='description']", "attr": "content" },
    { "field": "cover", "selector": "img[src*='/upload/vod/']", "attr": "src" }
  ],

  "parse": {
    "code": {
      "from": ["cover", "keywords"],
      "regex": "/upload/vod/[0-9-]+/(?<code>[0-9a-f]{32})\\."
    },
    "title": {
      "from": ["title"],
      "regex": "^(?<title>[^_\\-|]+)"
    }
  },

  "list": [
    {
      "name": "电视剧",
      "url": "https://www.mgtvtv.com/show/2/",
      "pageUrl": "https://www.mgtvtv.com/show/2-{page}/",
      "item": "a.video-item",
      "collect": [
        { "field": "url", "selector": "", "attr": "href" },
        { "field": "title", "selector": "img", "attr": "alt" },
        { "field": "cover", "selector": "img", "attr": "src" }
      ]
    }
  ]
}
